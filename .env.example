# Copy to .env for local development.

# Local default: embedded Postgres (PGlite) stored in .data/ — no Docker needed.
# To use a Neon dev branch instead, paste its pooled / direct connection strings.
DATABASE_URL=pglite://.data/pglite
DATABASE_URL_UNPOOLED=pglite://.data/pglite

NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
